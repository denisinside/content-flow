// Provider-owned auth tables are deliberately outside this application schema.
generator client {
  provider               = "prisma-client"
  output                 = "../packages/backend/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["contextflow"]
}

model UserProfile {
  id          String       @id @db.Uuid
  displayName String?      @db.VarChar(80)
  idleTimeoutMinutes Int   @default(1440)
  externalProcessingNoticeVersion String? @db.VarChar(64)
  externalProcessingAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  sessions    AppSession[]
  createdProjects Project[]
  memberships ProjectMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvites WorkspaceInvite[] @relation("InviteSender")
  acceptedInvites WorkspaceInvite[] @relation("InviteAcceptor")
  styleRevisions WorkspaceStyleRevision[]
  createdAssets Asset[] @relation("AssetCreator")
  createdMaterials Material[] @relation("MaterialCreator")
  createdSnapshots SourceSnapshot[] @relation("SnapshotCreator")

  @@schema("contextflow")
}

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  ownerId String @db.Uuid
  owner UserProfile @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  styleRevision Int @default(1)
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  styles WorkspaceStyleRevision[]
  projects Project[]
  @@index([ownerId])
  @@schema("contextflow")
}

model WorkspaceMember {
  workspaceId String @db.Uuid
  userId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  leftAt DateTime? @db.Timestamptz(3)
  @@id([workspaceId, userId])
  @@index([userId, leftAt, workspaceId])
  @@schema("contextflow")
}

model WorkspaceInvite {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  email String @db.VarChar(254)
  tokenDigest String @unique @db.Char(64)
  invitedBy String @db.Uuid
  sender UserProfile @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptedBy String? @db.Uuid
  acceptor UserProfile? @relation("InviteAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  @@index([workspaceId, email, expiresAt])
  @@schema("contextflow")
}

model WorkspaceStyleRevision {
  workspaceId String @db.Uuid
  revision Int
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brandbook String @default("") @db.Text
  tone String @default("") @db.Text
  settings Json @default("{}")
  createdBy String @db.Uuid
  creator UserProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([workspaceId, revision])
  @@schema("contextflow")
}

enum ProjectFormat {
  ARTICLE
  LINKEDIN_TEXT
  LINKEDIN_COVER
  LINKEDIN_CAROUSEL
  INSTAGRAM_COVER
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORIES
  TELEGRAM_POST
  @@schema("contextflow")
}

enum AssetState {
  STAGED
  AVAILABLE
  QUARANTINED
  @@schema("contextflow")
}

enum AssetPurpose {
  ORIGINAL
  NORMALIZED
  GENERATED
  EXPORT
  @@schema("contextflow")
}

enum MaterialKind {
  TEXT
  FILE
  @@schema("contextflow")
}

enum MaterialPurpose {
  FACTUAL_SOURCE
  NOTES
  BRANDBOOK
  STYLE_SAMPLE
  SUPPLIED_ARTICLE
  @@schema("contextflow")
}

enum SourceOrigin {
  MANUAL_TEXT
  LOCAL_FILE
  @@schema("contextflow")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  topic String @db.VarChar(500)
  formats ProjectFormat[]
  revision Int @default(1)
  createdBy String @db.Uuid
  creator UserProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  members ProjectMember[]
  assets Asset[]
  materials Material[]
  @@index([createdBy])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@schema("contextflow")
}

model ProjectMember {
  projectId String @db.Uuid
  userId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  leftAt DateTime? @db.Timestamptz(3)
  @@id([projectId, userId])
  @@index([userId, leftAt, projectId])
  @@schema("contextflow")
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bucket String @db.VarChar(63)
  objectKey String @db.VarChar(1024)
  mediaType String @db.VarChar(255)
  bytes BigInt
  sha256 String @db.Char(64)
  state AssetState @default(STAGED)
  purpose AssetPurpose
  createdBy String @db.Uuid
  creator UserProfile @relation("AssetCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sourceSnapshots SourceSnapshot[]
  @@unique([projectId, id])
  @@unique([bucket, objectKey])
  @@index([projectId, state, createdAt])
  @@index([projectId, createdBy])
  @@schema("contextflow")
}

model Material {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind MaterialKind
  purpose MaterialPurpose
  label String @db.VarChar(200)
  included Boolean @default(true)
  revision Int @default(1)
  currentSnapshotId String? @db.Uuid
  createdBy String @db.Uuid
  creator UserProfile @relation("MaterialCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  snapshots SourceSnapshot[] @relation("MaterialSnapshots")
  currentSnapshot SourceSnapshot? @relation("MaterialCurrentSnapshot", fields: [projectId, id, currentSnapshotId], references: [projectId, materialId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projectId, id])
  @@index([projectId, included, createdAt, id])
  @@index([projectId, currentSnapshotId])
  @@schema("contextflow")
}

model SourceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  materialId String @db.Uuid
  material Material @relation("MaterialSnapshots", fields: [projectId, materialId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  currentForMaterials Material[] @relation("MaterialCurrentSnapshot")
  sequence Int
  normalizedText String @db.Text
  sha256 String @db.Char(64)
  bytes Int
  origin SourceOrigin
  originalAssetId String? @db.Uuid
  originalFilename String? @db.VarChar(255)
  originalAsset Asset? @relation(fields: [projectId, originalAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  previousSnapshotId String? @db.Uuid
  previousSnapshot SourceSnapshot? @relation("SnapshotHistory", fields: [projectId, materialId, previousSnapshotId], references: [projectId, materialId, id], onDelete: Restrict, onUpdate: NoAction)
  nextSnapshots SourceSnapshot[] @relation("SnapshotHistory")
  createdBy String @db.Uuid
  creator UserProfile @relation("SnapshotCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  fragments SourceFragment[]

  @@unique([projectId, id])
  @@unique([projectId, materialId, id])
  @@unique([projectId, materialId, sequence])
  @@unique([projectId, materialId, previousSnapshotId])
  @@index([projectId, materialId, createdAt, id])
  @@index([projectId, originalAssetId])
  @@schema("contextflow")
}

model SourceFragment {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  snapshotId String @db.Uuid
  snapshot SourceSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  ordinal Int
  startOffset Int
  endOffset Int
  sha256 String @db.Char(64)

  @@unique([projectId, id])
  @@unique([projectId, snapshotId, ordinal])
  @@index([projectId, snapshotId, startOffset])
  @@schema("contextflow")
}

model AppSession {
  id                     String      @id @db.Uuid
  cookieDigest           String      @unique @db.Char(64)
  userId                 String      @db.Uuid
  user                   UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  encryptedProviderTokens String?
  tokenKeyVersion        Int
  providerSessionId      String?     @db.Uuid
  providerTokenExpiresAt DateTime    @db.Timestamptz(3)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  lastUserActivityAt     DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt              DateTime    @db.Timestamptz(3)
  revokedAt              DateTime?   @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@schema("contextflow")
}
