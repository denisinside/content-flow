// Provider-owned auth tables are deliberately outside this application schema.
generator client {
  provider               = "prisma-client"
  output                 = "../packages/backend/src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["contextflow"]
}

model UserProfile {
  id          String       @id @db.Uuid
  displayName String?      @db.VarChar(80)
  idleTimeoutMinutes Int   @default(1440)
  externalProcessingNoticeVersion String? @db.VarChar(64)
  externalProcessingAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  sessions    AppSession[]
  presences EditorPresence[]
  requestedObjectDeletions PrivateObjectDeletion[] @relation("ObjectDeletionRequester")
  createdProjects Project[]
  memberships ProjectMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvites WorkspaceInvite[] @relation("InviteSender")
  acceptedInvites WorkspaceInvite[] @relation("InviteAcceptor")
  exportRequests ExportRequest[] @relation("ExportRequester")
  styleRevisions WorkspaceStyleRevision[]
  createdWorkspaceVisualAssets WorkspaceVisualAsset[] @relation("WorkspaceVisualAssetCreator")
  visualDrafts VisualCompositionDraft[] @relation("VisualDraftEditor")
  visualRevisions VisualCompositionRevision[] @relation("VisualRevisionCreator")
  createdAssets Asset[] @relation("AssetCreator")
  createdMaterials Material[] @relation("MaterialCreator")
  createdSnapshots SourceSnapshot[] @relation("SnapshotCreator")
  createdSearchIndexes SourceSearchIndex[] @relation("SourceSearchIndexCreator")
  createdEvidenceSpans SourceEvidenceSpan[] @relation("SourceEvidenceSpanCreator")
  createdEvidencePackets SourceEvidencePacket[] @relation("SourceEvidencePacketCreator")
  createdEvidenceSets SourceEvidenceSet[] @relation("SourceEvidenceSetCreator")
  requestedSourceWritingRequests SourceWritingRequest[] @relation("SourceWritingRequestRequester")
  requestedJobs Job[] @relation("JobRequester")
  claims Claim[] @relation("ClaimCreator")
  claimRevisions ClaimRevision[] @relation("ClaimRevisionCreator")
  approvedClaims ClaimRevision[] @relation("ClaimApprover")
  rejectedClaims ClaimRevision[] @relation("ClaimRejector")
  withdrawnClaims ClaimRevision[] @relation("ClaimWithdrawer")
  claimEvidence ClaimEvidence[] @relation("EvidenceCreator")
  invalidatedEvidence ClaimEvidence[] @relation("EvidenceInvalidator")
  claimConflicts ClaimConflict[] @relation("ConflictCreator")
  resolvedConflicts ClaimConflict[] @relation("ConflictResolver")
  factualBases FactualBasisRevision[] @relation("BasisCreator")
  briefRevisions BriefRevision[] @relation("BriefCreator")
  outlineRevisions OutlineRevision[] @relation("OutlineCreator")
  articleDrafts ArticleDraft[] @relation("ArticleDraftEditor")
  articleVersions ArticleVersion[] @relation("ArticleVersionCreator")
  articleAnnotations ArticleAnnotation[] @relation("AnnotationCreator")
  annotationPosts ArticleAnnotationPost[] @relation("AnnotationPostCreator")
  googleConnections GoogleDriveConnection[]
  googleOAuthAttempts GoogleOAuthAttempt[]
  googleDocBindings GoogleDocBinding[] @relation("GoogleDocBindingCreator")
  googleDocSnapshots GoogleDocSnapshot[] @relation("GoogleDocSnapshotCapturer")
  googleDocBindCommands GoogleDocBindCommand[] @relation("GoogleDocBindCommandCreator")
  googleDocCreateCommands GoogleDocCreateCommand[]
  googleDocSyncPreviews GoogleDocSyncPreview[] @relation("GoogleDocSyncPreviewRequester")
  googleDocSyncOperations GoogleDocSyncOperation[] @relation("GoogleDocSyncOperationRequester")
  googleDocSyncStates GoogleDocSyncState[] @relation("GoogleDocSyncBackgroundUser")
  articleApprovals ArticleVersion[] @relation("ArticleApprover")
  articleWithdrawals ArticleVersion[] @relation("ArticleWithdrawer")
  adaptationDrafts AdaptationDraft[] @relation("AdaptationDraftEditor")
  adaptationRevisions AdaptationRevision[] @relation("AdaptationRevisionCreator")
  adaptationApprovals AdaptationRevision[] @relation("AdaptationApprover")
  adaptationWithdrawals AdaptationRevision[] @relation("AdaptationWithdrawer")
  articleReviewReceipts ArticleVersion[] @relation("ArticleReviewer")
  adaptationReviewReceipts AdaptationRevision[] @relation("AdaptationReviewer")
  approvedOutlines OutlineRevision[] @relation("OutlineApprover")
  withdrawnOutlines OutlineRevision[] @relation("OutlineWithdrawer")
  createdLanguageSuggestions LanguageSuggestion[] @relation("LanguageSuggestionCreator")
  decidedLanguageSuggestions LanguageSuggestion[] @relation("LanguageSuggestionDecider")
  createdScriptLanguageSuggestions ScriptLanguageSuggestion[] @relation("ScriptLanguageSuggestionCreator")
  decidedScriptLanguageSuggestions ScriptLanguageSuggestion[] @relation("ScriptLanguageSuggestionDecider")

  @@schema("contextflow")
}

model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  ownerId String @db.Uuid
  owner UserProfile @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  trashedAt DateTime? @db.Timestamptz(3)
  purgeAfter DateTime? @db.Timestamptz(3)
  lifecycleRevision Int @default(1)
  styleRevision Int @default(1)
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  styles WorkspaceStyleRevision[]
  visualAssets WorkspaceVisualAsset[]
  projects Project[]
  @@index([ownerId])
  @@schema("contextflow")
}

model WorkspaceMember {
  workspaceId String @db.Uuid
  userId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  leftAt DateTime? @db.Timestamptz(3)
  @@id([workspaceId, userId])
  @@index([userId, leftAt, workspaceId])
  @@schema("contextflow")
}

model WorkspaceInvite {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  email String @db.VarChar(254)
  tokenDigest String @unique @db.Char(64)
  invitedBy String @db.Uuid
  sender UserProfile @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptedBy String? @db.Uuid
  acceptor UserProfile? @relation("InviteAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  @@index([workspaceId, email, expiresAt])
  @@schema("contextflow")
}

model WorkspaceStyleRevision {
  workspaceId String @db.Uuid
  revision Int
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  brandbook String @default("") @db.Text
  tone String @default("") @db.Text
  settings Json @default("{}")
  createdBy String @db.Uuid
  creator UserProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  briefRevisions BriefRevision[]
  articleDrafts ArticleDraft[]
  articleVersions ArticleVersion[] @relation("ArticleVersionStyle")
  reviewedArticleVersions ArticleVersion[] @relation("ArticleVersionReviewedStyle")
  adaptationDrafts AdaptationDraft[] @relation("AdaptationDraftStyle")
  adaptationRevisions AdaptationRevision[] @relation("AdaptationRevisionStyle")
  reviewedAdaptationRevisions AdaptationRevision[] @relation("AdaptationRevisionReviewedStyle")
  visualDrafts VisualCompositionDraft[] @relation("VisualDraftStyle")
  visualRevisions VisualCompositionRevision[] @relation("VisualRevisionStyle")
  @@id([workspaceId, revision])
  @@schema("contextflow")
}

enum ProjectFormat {
  ARTICLE
  LINKEDIN_TEXT
  LINKEDIN_COVER
  LINKEDIN_CAROUSEL
  INSTAGRAM_COVER
  INSTAGRAM_CAROUSEL
  INSTAGRAM_STORIES
  TELEGRAM_POST
  @@schema("contextflow")
}

enum AssetState {
  STAGED
  AVAILABLE
  QUARANTINED
  @@schema("contextflow")
}

enum AssetPurpose {
  ORIGINAL
  NORMALIZED
  GENERATED
  EXPORT
  @@schema("contextflow")
}

enum MaterialKind {
  TEXT
  FILE
  URL
  @@schema("contextflow")
}

enum MaterialPurpose {
  FACTUAL_SOURCE
  NOTES
  BRANDBOOK
  STYLE_SAMPLE
  SUPPLIED_ARTICLE
  @@schema("contextflow")
}

enum SourceOrigin {
  MANUAL_TEXT
  LOCAL_FILE
  WEB_IMPORT
  DOCUMENT_IMPORT
  @@schema("contextflow")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  topic String @db.VarChar(500)
  formats ProjectFormat[]
  revision Int @default(1)
  createdBy String @db.Uuid
  creator UserProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  trashedAt DateTime? @db.Timestamptz(3)
  purgeAfter DateTime? @db.Timestamptz(3)
  members ProjectMember[]
  presences EditorPresence[]
  assets Asset[]
  materials Material[]
  jobs Job[]
  sourceSearchIndexes SourceSearchIndex[]
  sourceSearchChunks SourceSearchChunk[]
  sourceEvidenceSpans SourceEvidenceSpan[]
  sourceEvidencePackets SourceEvidencePacket[]
  sourceEvidenceSets SourceEvidenceSet[]
  sourceWritingRequests SourceWritingRequest[]
  sourceArticleAssemblies SourceArticleAssembly[]
  claims Claim[]
  claimConflicts ClaimConflict[]
  factualBases FactualBasisRevision[]
  brief Brief?
  briefRevisions BriefRevision[]
  articleDrafts ArticleDraft[]
  articleVersions ArticleVersion[]
  googleDocBindings GoogleDocBinding[]
  googleDocBindCommands GoogleDocBindCommand[]
  googleDocCreateCommands GoogleDocCreateCommand[]
  googleDocSyncPreviews GoogleDocSyncPreview[]
  googleDocSyncOperations GoogleDocSyncOperation[]
  googleDocSyncStates GoogleDocSyncState[]
  googleDocRemoteThreads GoogleDocRemoteThread[]
  googleDocAnnotationEvents GoogleDocAnnotationEvent[]
  googleDocSnapshotCandidates GoogleDocSnapshotCandidate[]
  adaptations Adaptation[]
  languageSuggestions LanguageSuggestion[]
  scriptLanguageSuggestions ScriptLanguageSuggestion[]
  exportRequests ExportRequest[]
  exportItems ExportItem[]
  exportArtifacts ExportArtifact[]
  visualCompositions VisualComposition[] @relation("VisualCompositionProjectWorkspace")
  adaptationDrafts AdaptationDraft[] @relation("AdaptationDraftProjectWorkspace")
  adaptationRevisions AdaptationRevision[] @relation("AdaptationRevisionProjectWorkspace")
  outline Outline?
  article Article?
  @@unique([id, workspaceId])
  @@index([createdBy])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@schema("contextflow")
}

model ProjectMember {
  projectId String @db.Uuid
  userId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  leftAt DateTime? @db.Timestamptz(3)
  @@id([projectId, userId])
  @@index([userId, leftAt, projectId])
  @@schema("contextflow")
}

model Asset {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bucket String @db.VarChar(63)
  objectKey String @db.VarChar(1024)
  mediaType String @db.VarChar(255)
  bytes BigInt
  sha256 String @db.Char(64)
  state AssetState @default(STAGED)
  purpose AssetPurpose
  createdBy String @db.Uuid
  creator UserProfile @relation("AssetCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sourceSnapshots SourceSnapshot[]
  originalMaterials Material[] @relation("MaterialOriginal")
  exportArtifacts ExportArtifact[]
  visualPreviews VisualPreview[]
  @@unique([projectId, id])
  @@unique([bucket, objectKey])
  @@index([projectId, state, createdAt])
  @@index([projectId, createdBy])
  @@schema("contextflow")
}

model Material {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind MaterialKind
  purpose MaterialPurpose
  label String @db.VarChar(200)
  included Boolean @default(true)
  revision Int @default(1)
  currentSnapshotId String? @db.Uuid
  sourceUrl String? @db.VarChar(2048)
  originalAssetId String? @db.Uuid
  originalFilename String? @db.VarChar(255)
  originalAsset Asset? @relation("MaterialOriginal", fields: [projectId, originalAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy String @db.Uuid
  creator UserProfile @relation("MaterialCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  snapshots SourceSnapshot[] @relation("MaterialSnapshots")
  currentSnapshot SourceSnapshot? @relation("MaterialCurrentSnapshot", fields: [projectId, id, currentSnapshotId], references: [projectId, materialId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projectId, id])
  @@index([projectId, included, createdAt, id])
  @@index([projectId, currentSnapshotId])
  @@schema("contextflow")
}

model SourceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  materialId String @db.Uuid
  material Material @relation("MaterialSnapshots", fields: [projectId, materialId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  currentForMaterials Material[] @relation("MaterialCurrentSnapshot")
  sequence Int
  normalizedText String @db.Text
  sha256 String @db.Char(64)
  bytes Int
  origin SourceOrigin
  providerMetadata Json?
  jobId String? @db.Uuid
  job Job? @relation(fields: [projectId, jobId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  originalAssetId String? @db.Uuid
  originalFilename String? @db.VarChar(255)
  originalAsset Asset? @relation(fields: [projectId, originalAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  previousSnapshotId String? @db.Uuid
  previousSnapshot SourceSnapshot? @relation("SnapshotHistory", fields: [projectId, materialId, previousSnapshotId], references: [projectId, materialId, id], onDelete: Restrict, onUpdate: NoAction)
  nextSnapshots SourceSnapshot[] @relation("SnapshotHistory")
  createdBy String @db.Uuid
  creator UserProfile @relation("SnapshotCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  fragments SourceFragment[]
  searchIndexes SourceSearchIndex[]
  searchChunks SourceSearchChunk[]
  evidenceSpans SourceEvidenceSpan[]
  claimEvidence ClaimEvidence[]
  briefContexts BriefContextSnapshot[]
  articleDrafts ArticleDraft[]
  articleVersions ArticleVersion[]

  @@unique([projectId, id])
  @@unique([projectId, jobId])
  @@unique([projectId, materialId, id])
  @@unique([projectId, materialId, sequence])
  @@unique([projectId, materialId, previousSnapshotId])
  @@index([projectId, materialId, createdAt, id])
  @@index([projectId, originalAssetId])
  @@schema("contextflow")
}

enum JobOperation {
  VISUAL_BACKGROUND_GENERATION
  WEB_IMPORT
  DOCUMENT_IMPORT
  CLAIM_EXTRACTION
  OUTLINE_GENERATION
  ARTICLE_GENERATION
  TELEGRAM_GENERATION
  EXPORT_BUILD
  GOOGLE_DOCS_SYNC
  SOURCE_EMBEDDING
  EVIDENCE_SEARCH
  SOURCE_WRITING
  BRIEF_PROPOSAL
  @@schema("contextflow")
}

model VisualBackgroundCandidate {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 compositionRevisionId String @db.Uuid
 frameId String @db.Uuid
 jobId String @unique @db.Uuid
 aiExecutionId String @db.Uuid
 assetId String @unique @db.Uuid
 report Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([projectId,id])
 @@schema("contextflow")
}

model VisualBackgroundApplication {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid
 candidateId String @db.Uuid
 commandKey String @db.VarChar(128)
 inputHash String @db.Char(64)
 appliedBy String @db.Uuid
 draftCounter Int
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([projectId,commandKey])
 @@schema("contextflow")
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
  OUTCOME_UNKNOWN
  @@schema("contextflow")
}

enum ProviderOutcome {
  NOT_SUBMITTED
  KNOWN_FAILED
  KNOWN_SUCCEEDED
  MAY_STILL_RUN
  UNKNOWN
  @@schema("contextflow")
}

model Job {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  requestedBy String @db.Uuid
  requester UserProfile @relation("JobRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operation JobOperation
  contractVersion String @db.VarChar(64)
  commandKey String @db.VarChar(128)
  inputManifest Json
  inputHash String @db.Char(64)
  status JobStatus @default(QUEUED)
  attemptCount Int @default(0)
  fencingToken Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  deadlineAt DateTime @db.Timestamptz(3)
  cancelRequestedAt DateTime? @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  progressStage String @default("WAITING") @db.VarChar(64)
  resultRefs Json?
  errorCategory String? @db.VarChar(64)
  providerOutcome ProviderOutcome @default(NOT_SUBMITTED)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  attempts JobAttempt[]
  sourceSnapshots SourceSnapshot[]
  claimRevisions ClaimRevision[]
  aiExecutions AIExecution[]
  outlineRevisions OutlineRevision[]
  articleVersions ArticleVersion[]
  adaptationRevisions AdaptationRevision[]
  exportRequest ExportRequest?
  googleDocSyncOperation GoogleDocSyncOperation?
  sourceChunkEmbeddings SourceChunkEmbedding[]
  sourceEvidencePacket SourceEvidencePacket?
  @@unique([projectId, id])
  @@unique([projectId, operation, commandKey])
  @@index([status, nextAttemptAt])
  @@index([projectId, createdAt, id])
  @@schema("contextflow")
}

model JobAttempt {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ordinal Int
  fencingToken Int
  leaseOwner String @db.VarChar(128)
  leaseExpiresAt DateTime @db.Timestamptz(3)
  heartbeatAt DateTime @db.Timestamptz(3)
  providerSubmittedAt DateTime? @db.Timestamptz(3)
  providerRunId String? @db.VarChar(200)
  providerOutcome ProviderOutcome @default(NOT_SUBMITTED)
  errorCategory String? @db.VarChar(64)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  aiExecutions AIExecution[]
  @@unique([jobId, id])
  @@unique([jobId, ordinal])
  @@unique([jobId, fencingToken])
  @@index([leaseExpiresAt, finishedAt])
  @@schema("contextflow")
}

model SourceFragment {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  snapshotId String @db.Uuid
  snapshot SourceSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  ordinal Int
  startOffset Int
  endOffset Int
  sha256 String @db.Char(64)
  claimEvidence ClaimEvidence[]
  evidenceSpans SourceEvidenceSpan[]

  @@unique([projectId, id])
  @@unique([projectId, snapshotId, id])
  @@unique([projectId, snapshotId, ordinal])
  @@index([projectId, snapshotId, startOffset])
  @@schema("contextflow")
}

model SourceSearchIndex {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshotId String @db.Uuid
  snapshot SourceSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshotSha256 String @db.Char(64)
  chunkerVersion String @db.VarChar(64)
  model String @default("gemini-embedding-001") @db.VarChar(64)
  dimensions Int @default(768)
  configDigest String @db.Char(64)
  createdBy String @db.Uuid
  creator UserProfile @relation("SourceSearchIndexCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  chunks SourceSearchChunk[]
  @@unique([projectId, id])
  @@unique([projectId, snapshotId, configDigest])
  @@index([projectId, snapshotId, createdAt])
  @@schema("contextflow")
}

model SourceSearchChunk {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  indexId String @db.Uuid
  searchIndex SourceSearchIndex @relation(fields: [projectId, indexId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshotId String @db.Uuid
  snapshot SourceSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  snapshotSha256 String @db.Char(64)
  ordinal Int
  startOffset Int
  endOffset Int
  sha256 String @db.Char(64)
  text String @db.VarChar(1536)
  requiresEmbedding Boolean
  searchVector Unsupported("tsvector") @default(dbgenerated())
  embedding SourceChunkEmbedding?
  @@unique([projectId, id])
  @@unique([projectId, indexId, ordinal])
  @@index([projectId, snapshotId, startOffset])
  @@schema("contextflow")
}

model SourceChunkEmbedding {
  projectId String @db.Uuid
  chunkId String @db.Uuid
  chunk SourceSearchChunk @relation(fields: [projectId, chunkId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  jobId String @db.Uuid
  job Job @relation(fields: [projectId, jobId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  embedding Unsupported("vector(768)")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([projectId, chunkId])
  @@index([projectId, jobId])
  @@schema("contextflow")
}

model SourceEvidenceSpan {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshotId String @db.Uuid
  snapshot SourceSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  fragmentId String @db.Uuid
  fragment SourceFragment @relation(fields: [projectId, snapshotId, fragmentId], references: [projectId, snapshotId, id], onDelete: Restrict, onUpdate: NoAction)
  startOffset Int
  endOffset Int
  quote String @db.Text
  sha256 String @db.Char(64)
  snapshotSha256 String @db.Char(64)
  createdBy String @db.Uuid
  creator UserProfile @relation("SourceEvidenceSpanCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  packetItems SourceEvidencePacketItem[]
  @@unique([projectId, id])
  @@unique([projectId, snapshotId, id])
  @@index([projectId, snapshotId, startOffset])
  @@schema("contextflow")
}

model SourceEvidencePacket {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  jobId String @unique @db.Uuid
  job Job @relation(fields: [projectId, jobId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  query String @db.Text
  manifestJson Json
  sha256 String @db.Char(64)
  createdBy String @db.Uuid
  creator UserProfile @relation("SourceEvidencePacketCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  items SourceEvidencePacketItem[]
  evidenceSets SourceEvidenceSetPacket[]
  @@unique([projectId, id])
  @@unique([projectId, jobId])
  @@schema("contextflow")
}

model SourceEvidencePacketItem {
  projectId String @db.Uuid
  packetId String @db.Uuid
  packet SourceEvidencePacket @relation(fields: [projectId, packetId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  spanId String @db.Uuid
  span SourceEvidenceSpan @relation(fields: [projectId, spanId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  ordinal Int
  outlineCitations OutlineRevisionSourceCitation[]
  articleCitations ArticleVersionSourceCitation[]
