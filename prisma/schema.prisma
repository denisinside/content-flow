  scriptRevision ScriptRevision? @relation("ExportScriptRevision",fields:[projectId,scriptRevisionId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
  visualRevisionId String? @db.Uuid
  visualRevision VisualCompositionRevision? @relation("ExportVisualRevision",fields:[projectId,visualRevisionId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
  @@unique([projectId,id])
  @@unique([requestId,ordinal])
  @@unique([requestId,articleVersionId])
  @@unique([requestId,adaptationRevisionId])
  @@unique([requestId,scriptRevisionId])
  @@unique([requestId,visualRevisionId])
  @@schema("contextflow")
}

model ExportArtifact {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  requestId String @unique @db.Uuid
  request ExportRequest @relation(fields:[projectId,requestId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
  assetId String @unique @db.Uuid
  asset Asset @relation(fields:[projectId,assetId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
  sha256 String @db.Char(64)
  byteSize Int
  contentType String @db.VarChar(100)
  filename String @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([projectId,id])
  @@unique([projectId,requestId])
  @@index([projectId,createdAt,id])
  @@schema("contextflow")
}
