{
  "name": "contextflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.19.0 <25", "pnpm": "11.19.0" },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "pnpm db:generate && pnpm --filter @contextflow/backend build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm db:generate && pnpm --filter @contextflow/backend build && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test:unit": "pnpm prepare:backend && vitest run --project unit",
    "test:integration": "pnpm prepare:backend && pnpm db:migrate:test && vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm verify:prisma && pnpm verify:bootstrap",
    "deps:up": "pnpm deps:test:up",
    "deps:test:up": "node scripts/test-dependencies.mjs",
    "deps:down": "docker compose --env-file .env -f infra/compose.dev.yml --profile test down",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "prepare:backend": "pnpm db:generate && pnpm --filter @contextflow/backend build",
    "verify:connections": "pnpm prepare:backend && tsx scripts/check-connections.ts",
    "verify:auth": "pnpm prepare:backend && tsx scripts/check-auth.ts",
    "verify:migrations": "node scripts/verify-test-migrations.mjs",
    "verify:prisma": "node scripts/verify-prisma.mjs",
    "verify:bootstrap": "node scripts/verify-bootstrap.mjs"
  },
  "devDependencies": {
    "@contextflow/backend": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1"
  }
}
