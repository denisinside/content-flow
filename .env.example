# Cloud development + isolated local TEST. env:init adds missing generated TEST keys only.
# This file contains examples only. Real .env is ignored by Git.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
WEB_ORIGIN=http://localhost:5173
DEPENDENCY_TIMEOUT_MS=3000

# Only the isolated TEST PostgreSQL is local; env:init generates its credentials.
TEST_POSTGRES_ADMIN_PASSWORD=GENERATE_TEST_ADMIN_PASSWORD
TEST_POSTGRES_MIGRATION_PASSWORD=GENERATE_TEST_MIGRATION_PASSWORD
TEST_POSTGRES_RUNTIME_PASSWORD=GENERATE_TEST_RUNTIME_PASSWORD

# API/worker use the limited runtime role. Prisma CLI uses the migration role.
# Supabase session pooler: cf_runtime.PROJECT_REF / cf_migrate.PROJECT_REF, port 5432.
# Replace placeholders with your actual connection details; URL-encode role passwords.
DATABASE_URL=postgresql://cf_runtime.PROJECT_REF:RUNTIME_PASSWORD@POOLER_HOST:5432/postgres?schema=contextflow&sslmode=require
DIRECT_DATABASE_URL=postgresql://cf_migrate.PROJECT_REF:MIGRATION_PASSWORD@POOLER_HOST:5432/postgres?schema=contextflow&sslmode=require
# Optional PEM CA file for verified cloud PostgreSQL TLS (relative to project root).
DATABASE_SSL_CA_FILE=

# Upstash: copy Console > Connect > TCP Redis URL (rediss://default:PASSWORD@HOST:6379).
# HTTP REST URL/token cannot be used by ioredis/BullMQ. No Upstash REST variables are needed.
REDIS_URL=rediss://default:UPSTASH_PASSWORD@UPSTASH_HOST:6379

# Tests never fall back to the development or production services.
# Leave these local defaults for isolated Docker tests; cloud testing needs separate test services.
TEST_DATABASE_URL=postgresql://cf_runtime:GENERATE_TEST_RUNTIME_PASSWORD@127.0.0.1:54330/contextflow_test?schema=contextflow
TEST_DIRECT_DATABASE_URL=postgresql://cf_migrate:GENERATE_TEST_MIGRATION_PASSWORD@127.0.0.1:54330/contextflow_test?schema=contextflow
TEST_DATABASE_SSL_CA_FILE=
TEST_REDIS_URL=redis://127.0.0.1:63830/0

# Required for M1.2. No frontend VITE_ provider credentials.
# Project Settings > API: project URL and publishable key (legacy anon key also supported).
# Use a dedicated DEV/TEST Supabase project. These values stay server-side here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# M2 private Storage operations only: Supabase secret key (legacy service_role equivalent).
SUPABASE_SECRET_KEY=
# M2.1 originals: pre-create this PRIVATE bucket; no browser access or public URLs.
# Development can explicitly choose filesystem; production uses Supabase.
PRIVATE_ASSET_DRIVER=supabase
SUPABASE_ORIGINALS_BUCKET=contextflow-originals

# Server-only 32-byte base64 keys, generated locally. Keep backup outside the database.
SESSION_ENCRYPTION_KEY=GENERATE_SESSION_ENCRYPTION_KEY
SESSION_ENCRYPTION_KEY_VERSION=1
SESSION_CSRF_KEY=GENERATE_SESSION_CSRF_KEY
# Optional JSON map of old key versions to base64 keys during encryption rotation.
SESSION_PREVIOUS_ENCRYPTION_KEYS=
# Personal idle timeout defaults to 24 hours and is saved per user in the app.
# The absolute session deadline is fixed at seven days from sign-in.
AUTH_PROVIDER_TIMEOUT_MS=5000

# Local GoTrue is the real Supabase Auth server, isolated from your cloud project.
# TEST email auto-confirm is enabled ONLY in infra/compose.dev.yml.
TEST_AUTH_POSTGRES_PASSWORD=GENERATE_TEST_AUTH_POSTGRES_PASSWORD
TEST_AUTH_JWT_SECRET=GENERATE_TEST_AUTH_JWT_SECRET
TEST_SUPABASE_URL=http://127.0.0.1:54331
TEST_SUPABASE_PUBLISHABLE_KEY=GENERATE_TEST_SUPABASE_PUBLISHABLE_KEY
TEST_SUPABASE_SECRET_KEY=GENERATE_TEST_SUPABASE_SECRET_KEY
TEST_SESSION_ENCRYPTION_KEY=GENERATE_TEST_SESSION_ENCRYPTION_KEY
TEST_SESSION_ENCRYPTION_KEY_VERSION=1
TEST_SESSION_CSRF_KEY=GENERATE_TEST_SESSION_CSRF_KEY
TEST_SESSION_PREVIOUS_ENCRYPTION_KEYS=
